#!/usr/bin/env sh
# Formats the Rust files being committed, then re-stages them.
#
# CI's fmt job is a hard gate, and every failure it could report is one
# rustfmt fixes without judgement. Doing it here means the gate never costs
# a round trip.
#
# Only *staged* files are touched — unstaged work is left alone.
#
# Enable once, per clone:
#   git config core.hooksPath .githooks
set -e

files=$(git diff --name-only --cached --diff-filter=ACM -- '*.rs')
[ -z "$files" ] && exit 0

command -v rustfmt >/dev/null 2>&1 || {
    echo "pre-commit: rustfmt not found, skipping format" >&2
    exit 0
}

# rustfmt has to be told the edition — left alone it assumes 2015 — and it has
# to be the crate's own. Hardcoding 2021 against an edition-2024 crate is what
# left CI's fmt gate red for weeks: the hook rewrote files in a style
# `cargo fmt --all --check` then rejected, on every commit. Read it from
# Cargo.toml so the two cannot drift apart again.
edition=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml | head -1)

printf '%s\n' "$files" | xargs rustfmt --edition "${edition:-2024}"
printf '%s\n' "$files" | xargs git add --
